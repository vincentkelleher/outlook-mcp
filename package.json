{
  "name": "outlook-skill",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Outlook email for AI agents: a Node CLI and MCP server that reads mail and creates drafts, never sends it.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vincentkelleher/outlook-skill.git"
  },
  "keywords": [
    "outlook",
    "microsoft-graph",
    "email",
    "mcp",
    "model-context-protocol",
    "agent-skill"
  ],
  "bin": {
    "outlook-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "test:e2e": "node --test e2e/*.e2e.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@azure/msal-node": "5.5.0",
    "@microsoft/microsoft-graph-client": "3.0.7",
    "@modelcontextprotocol/sdk": "1.32.1",
    "commander": "15.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "prettier": "^3.9.6",
    "typescript": "5.9.3"
  }
}
